{
    "name": "Medical AI Dev Environment",
    "image": "python:3.10-slim",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:1": {}
    },
    "postCreateCommand": "apt-get update && apt-get install -y build-essential gcc && pip install -r requirements.txt",
    "remoteUser": "root"
}